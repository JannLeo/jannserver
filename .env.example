# Core authentication
# Generate strong random values, for example with: openssl rand -hex 32
SESSION_SECRET=replace_with_at_least_32_random_characters
INIT_TOKEN=replace_with_openssl_rand_hex_16
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_password
# Exact hostnames/IPs only. Use an explicit wildcard such as *.example.com when
# you intentionally want to trust subdomains.
ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Set true only when intentionally serving the app over trusted plain HTTP/Tailscale.
ALLOW_HTTP_COOKIES=false
# Leave false for direct Next/Docker exposure. PM2 enables this only on its
# loopback-only Next backend behind gateway.js, which overwrites forwarding IPs.
TRUST_PROXY_HEADERS=false

# Machine-to-machine API authentication
HERDR_API_KEY=replace_with_openssl_rand_hex_32
DELEGATION_API_KEY=replace_with_openssl_rand_hex_32

# Login rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# Database / local data
# Docker Compose overrides this to /data/app.db.
DB_PATH=./data/app.db
OBSIDIAN_VAULT_DIR=./data/obsidian-vault

# AI services
AI_BASE_URL=http://127.0.0.1:12345/v1
AI_MODEL=MiniMax-M2.7
AI_API_KEY=
MINIMAX_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Optional MediaCrawler service
MEDIA_CRAWLER_BASE_URL=http://127.0.0.1:8080
MEDIA_CRAWLER_ENABLED=true

# Optional WorldQuant Brain integration
BRAIN_API_URL=https://api.worldquantbrain.com
BRAIN_CREDENTIAL_EMAIL=
BRAIN_CREDENTIAL_PASSWORD=

# TailSSH / gateway
TAILSSH_BACKEND=http://127.0.0.1:9222
TAILSSH_TIMEOUT_MS=15000
PROXY_HOST=127.0.0.1
PROXY_PORT=3001
BACKEND_WS=ws://127.0.0.1:9222
WS_PROXY=ws://127.0.0.1:3001
GATEWAY_PORT=3000
NEXT_PORT=3002
OPENCODE_PORT=34567
PROXY_IDLE_TIMEOUT_MS=300000

# PM2 portability overrides. Usually leave unset: ecosystem.config.js defaults to
# the repository directory and the currently running Node executable.
APP_CWD=
NODE_BIN=
