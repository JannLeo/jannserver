# Core authentication
# Generate strong random values, for example with: openssl rand -hex 32
SESSION_SECRET=replace_with_at_least_32_random_characters
INIT_TOKEN=replace_with_openssl_rand_hex_16
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_password
ALLOWED_HOSTS=localhost,127.0.0.1
# Set true only when intentionally serving the app over trusted plain HTTP/Tailscale.
ALLOW_HTTP_COOKIES=false

# Machine-to-machine API authentication
HERDR_API_KEY=replace_with_openssl_rand_hex_32
DELEGATION_API_KEY=replace_with_openssl_rand_hex_32

# Login rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# Database
DB_PATH=./data/app.db

# AI / PM2 runtime
AI_BASE_URL=http://127.0.0.1:12345/v1
AI_MODEL=MiniMax-M2.7
AI_API_KEY=
MINIMAX_API_KEY=
MEDIA_CRAWLER_BASE_URL=http://127.0.0.1:8080
MEDIA_CRAWLER_ENABLED=true
OBSIDIAN_VAULT_DIR=/home/sz/workspace/data/obsidian-vault
EMBEDDING_MODEL=text-embedding-3-small
BRAIN_API_URL=https://api.worldquantbrain.com
BRAIN_CREDENTIAL_EMAIL=
BRAIN_CREDENTIAL_PASSWORD=

# TailSSH / gateway
TAILSSH_BACKEND=http://127.0.0.1:9222
TAILSSH_TIMEOUT_MS=15000
PROXY_HOST=127.0.0.1
PROXY_PORT=3001
BACKEND_WS=ws://127.0.0.1:9222
GATEWAY_PORT=3000
NEXT_PORT=3002
OPENCODE_PORT=34567
PROXY_IDLE_TIMEOUT_MS=300000

# PM2 paths (override for non-default installations)
APP_CWD=/home/sz/workspace
NODE_BIN=/home/sz/.nvm/versions/node/v22.23.1/bin/node
NEXT_BIN=/home/sz/workspace/node_modules/.bin/next
NEXT_ARGS=start -p 3000
MEDIA_CRAWLER_SCRIPT=/models-ssd/personal-workspace/tools/MediaCrawler/.venv/bin/python
MEDIA_CRAWLER_ARGS=-m api.main run --host 127.0.0.1 --port 8080
MEDIA_CRAWLER_CWD=/models-ssd/personal-workspace/tools/MediaCrawler
